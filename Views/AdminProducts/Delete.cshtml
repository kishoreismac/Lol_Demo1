@model LandOLakesDairyDemo.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="form-card shadow-sm p-4 p-lg-5">
    <span class="eyebrow">Admin Delete</span>
    <h1 class="h2 mt-3 mb-2">Delete product</h1>
    <p class="text-muted">This removes the product from the demo catalog stored in SQLite.</p>

    <dl class="row mt-4 mb-4">
        <dt class="col-sm-3">Product</dt>
        <dd class="col-sm-9">@Model.ProductName</dd>

        <dt class="col-sm-3">Product ID</dt>
        <dd class="col-sm-9">@Model.ProductId</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@Model.Price.ToString("C")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Delete Product</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>