@model LandOLakesDairyDemo.Models.ProductCatalogViewModel

@{
    ViewData["Title"] = "Admin";
}

<section class="admin-shell rounded-4 p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-end">
        <div>
            <span class="eyebrow">Admin</span>
            <h1 class="display-6 mt-2 mb-1">Manage the product catalog</h1>
            <p class="text-muted mb-0">Create, edit, and delete products from the seeded SQLite catalog.</p>
        </div>
        <a class="btn btn-accent" asp-action="Create">Add Product</a>
    </div>
</section>

<form method="get" class="filter-bar rounded-4 p-3 p-lg-4 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-lg-5">
            <label class="form-label" for="searchTerm">Search by product name</label>
            <input class="form-control" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" placeholder="Search admin catalog" />
        </div>
        <div class="col-lg-4">
            <label class="form-label" for="category">Category</label>
            <select class="form-select" id="category" name="category">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category" selected="@(category == Model.SelectedCategory)">@category</option>
                }
            </select>
        </div>
        <div class="col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-accent flex-fill">Apply</button>
            <a class="btn btn-outline-secondary flex-fill" asp-action="Index">Reset</a>
        </div>
    </div>
</form>

<div class="table-card shadow-sm p-3 p-lg-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Package</th>
                    <th>Price</th>
                    <th>Featured</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@product.ProductName</div>
                            <div class="small text-muted">@product.ProductId</div>
                        </td>
                        <td>@product.Category</td>
                        <td>@product.PackageSize</td>
                        <td>@product.Price.ToString("C")</td>
                        <td>
                            @if (product.IsFeatured)
                            {
                                <span class="badge rounded-pill text-bg-warning">Yes</span>
                            }
                            else
                            {
                                <span class="text-muted">No</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">View</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@product.Id">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>