@model LandOLakesDairyDemo.Models.ProductInputModel

@{
    ViewData["Title"] = "Add Product";
}

<div class="form-card shadow-sm p-4 p-lg-5">
    <span class="eyebrow">Admin Create</span>
    <h1 class="h2 mt-3 mb-2">Add a new product</h1>
    <p class="text-muted">Use the approved categories and simple product metadata to expand the demo catalog.</p>

    <form asp-action="Create" method="post" class="mt-4">
        @await Html.PartialAsync("_ProductForm", Model)
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-accent">Save Product</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}