@model LandOLakesDairyDemo.Models.ProductCatalogViewModel

@{
    ViewData["Title"] = "Products";
}

<section class="mb-4">
    <span class="eyebrow">Catalog</span>
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mt-2">
        <div>
            <h1 class="display-6 mb-1">Browse dairy products</h1>
            <p class="text-muted mb-0">Search by product name and filter the catalog by category.</p>
        </div>
        <div class="d-flex flex-wrap gap-3">
            <div class="summary-stat">
                <span class="text-muted small">Products</span>
                <strong>@Model.Products.Count</strong>
            </div>
            <div class="summary-stat">
                <span class="text-muted small">Categories</span>
                <strong>@Model.Categories.Count</strong>
            </div>
        </div>
    </div>
</section>

<form method="get" class="filter-bar rounded-4 p-3 p-lg-4 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-lg-5">
            <label class="form-label" for="searchTerm">Search by product name</label>
            <input class="form-control" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" placeholder="Try Salted Butter" />
        </div>
        <div class="col-lg-4">
            <label class="form-label" for="category">Category</label>
            <select class="form-select" id="category" name="category">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category" selected="@(category == Model.SelectedCategory)">@category</option>
                }
            </select>
        </div>
        <div class="col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-accent flex-fill">Apply</button>
            <a class="btn btn-outline-secondary flex-fill" asp-action="Index">Reset</a>
        </div>
    </div>
</form>

@if (Model.Products.Count == 0)
{
    <div class="empty-state rounded-4 p-5 text-center">
        <h2 class="h4">No products matched the current filters.</h2>
        <p class="text-muted mb-0">Try a different product name or clear the category filter.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var product in Model.Products)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card product-card h-100 border-0 shadow-sm">
                    <div class="card-img-top product-image-placeholder d-flex justify-content-between align-items-start">
                        <span class="badge badge-soft rounded-pill">@product.Brand</span>
                        @if (product.IsFeatured)
                        {
                            <span class="badge rounded-pill text-bg-warning">Featured</span>
                        }
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            <div class="small text-muted mb-1">@product.Category</div>
                            <h2 class="h5 mb-0">@product.ProductName</h2>
                        </div>
                        <p class="text-muted">@product.ShortDescription</p>
                        <div class="d-flex justify-content-between align-items-center small text-secondary mb-3">
                            <span>@product.PackageSize</span>
                            <span class="price-pill">@product.Price.ToString("C")</span>
                        </div>
                        <a class="btn btn-outline-secondary mt-auto" asp-action="Details" asp-route-id="@product.Id">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}