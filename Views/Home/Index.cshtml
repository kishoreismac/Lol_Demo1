@model LandOLakesDairyDemo.Models.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<section class="hero-section rounded-4 p-4 p-lg-5 mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <span class="eyebrow">15-minute SDLC Showcase</span>
            <h1 class="display-5 fw-semibold mt-3 mb-3">A clean dairy catalog demo built for walkthroughs, not overhead.</h1>
            <p class="lead text-muted mb-4">
                LandOLakesDairyDemo presents a simple dairy-inspired catalog with search, category browsing, product details,
                admin CRUD, and API endpoints in one beginner-readable ASP.NET Core MVC application.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a class="btn btn-accent btn-lg" asp-controller="Products" asp-action="Index">Explore Products</a>
                <a class="btn btn-outline-secondary btn-lg" asp-controller="AdminProducts" asp-action="Index">Open Admin</a>
                <a class="btn btn-outline-secondary btn-lg" href="/swagger" target="_blank" rel="noreferrer">View API</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="hero-card rounded-4 p-4 h-100">
                <h2 class="h5 mb-3">Demo Highlights</h2>
                <ul class="list-unstyled mb-0 hero-checklist">
                    <li>Seeded dairy catalog with approved products</li>
                    <li>Search by product name and category filters</li>
                    <li>Admin create, edit, and delete flows</li>
                    <li>Swagger-backed JSON API surface</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
            <span class="eyebrow">Featured Products</span>
            <h2 class="h3 mb-0">Catalog favorites</h2>
        </div>
        <a class="link-offset-2" asp-controller="Products" asp-action="Index">See full catalog</a>
    </div>

    <div class="row g-4">
        @foreach (var product in Model.FeaturedProducts)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card product-card h-100 border-0 shadow-sm">
                    <div class="card-img-top product-image-placeholder d-flex align-items-end">
                        <span class="badge rounded-pill bg-light text-dark">@product.Category</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                            <h3 class="h5 card-title mb-0">@product.ProductName</h3>
                            <span class="price-pill">@product.Price.ToString("C")</span>
                        </div>
                        <p class="text-muted small mb-3">@product.ShortDescription</p>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="small text-secondary">@product.PackageSize</span>
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">Details</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section class="row g-4">
    <div class="col-lg-8">
        <div class="panel-card rounded-4 p-4 h-100">
            <span class="eyebrow">Category Coverage</span>
            <h2 class="h4 mt-2">Seeded for a credible demo</h2>
            <div class="d-flex flex-wrap gap-2 mt-3">
                @foreach (var category in Model.Categories)
                {
                    <a class="badge rounded-pill text-bg-light text-decoration-none px-3 py-2"
                       asp-controller="Products"
                       asp-action="Index"
                       asp-route-category="@category">@category</a>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel-card rounded-4 p-4 h-100">
            <span class="eyebrow">Tech Stack</span>
            <ul class="list-unstyled mb-0 mt-3 text-muted">
                <li class="mb-2">ASP.NET Core MVC (.NET 8)</li>
                <li class="mb-2">EF Core with SQLite</li>
                <li class="mb-2">Bootstrap 5 and Razor views</li>
                <li>Swagger for API exploration</li>
            </ul>
        </div>
    </div>
</section>
